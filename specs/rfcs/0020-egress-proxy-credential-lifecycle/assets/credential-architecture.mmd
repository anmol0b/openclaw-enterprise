flowchart TB
  %% All edges proposed; logical facets may share one trusted Backend object.
  OCC["<b>Source configuration</b><br/>OCC → Source control<br/>applySource"]
  Secret["<b>Selected SecretDriver</b><br/>Live / exact version<br/>or owned snapshot"]
  Resolver["<b>CredentialResolver</b><br/>resolve for one operation"]
  Lifecycle["<b>CredentialRefreshDriver</b><br/>One fenced family owner<br/>configureRefresh / prepare"]
  Warm["<b>WarmCredentialReader</b><br/>readWarm only<br/>Exact committed WarmKey"]
  Issuer["<b>CredentialIssuer</b><br/>issue / inspect / retire<br/>Registered provider hooks"]
  Provider["<b>Provider</b><br/>GitHub / OAuth issuance"]
  OCC -. configureRefresh .-> Lifecycle
  Lifecycle -. fenced issue .-> Issuer
  Issuer -. authorized input .-> Secret
  Issuer -. exchange .-> Provider
  Lifecycle -. commit before ready .-> Warm
  OCC -. static mode / material ref .-> Resolver
  Resolver -. selected store / exact target .-> Secret
  Resolver -. warm lookup only .-> Warm
  class OCC,Resolver api
  class Secret,Provider external
  class Lifecycle,Warm action
  class Issuer pending
  classDef api fill:#EDF2F7,stroke:#879AB0,color:#25364A,stroke-width:1px
  classDef action fill:#EBF3F0,stroke:#7F9D93,color:#2B4038,stroke-width:1px
  classDef external fill:#F2EDF6,stroke:#A394AF,color:#40354B,stroke-width:1px
  classDef pending fill:#F3F4F6,stroke:#98A2AE,color:#44505F,stroke-width:1px,stroke-dasharray:4 4

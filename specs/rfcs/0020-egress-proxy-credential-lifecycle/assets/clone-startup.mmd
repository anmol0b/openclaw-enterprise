---
flowchart TB
  Repo{"<b>Repository</b><br/>configured?"}
  Warm["<b>Startup warm wait</b><br/>CredentialRefreshDriver<br/>refreshStatus + receipt"]
  Bootstrap["<b>Trusted bootstrap</b><br/>Execution + repository<br/>delegation"]
  Sender["<b>EgressForwarder</b><br/>capture / forward<br/>check → resolve → check"]
  Clone["<b>Clone through sender</b><br/>EgressForwarder sends<br/>After usability check"]
  Start["<b>Compute starts Agent</b><br/>All required gates met"]
  Block["<b>Compute / bootstrap</b><br/>Block + own cleanup<br/>No blind clone replay"]
  Repo -. no clone .-> Start
  Repo -. yes .-> Warm
  Warm -. ready .-> Bootstrap
  Warm -. bound exceeded .-> Block
  Bootstrap -. each clone operation .-> Sender
  Sender -. allowed + usable .-> Clone
  Sender -. refused .-> Block
  Clone -. observed success .-> Start
  Clone -. failed / uncertain .-> Block
  class Bootstrap,Clone,Start action
  class Sender api
  class Repo,Warm,Block gate
  classDef api fill:#EDF2F7,stroke:#879AB0,color:#25364A,stroke-width:1px
  classDef action fill:#EBF3F0,stroke:#7F9D93,color:#2B4038,stroke-width:1px
  classDef external fill:#F2EDF6,stroke:#A394AF,color:#40354B,stroke-width:1px
  classDef gate fill:#F7F1E5,stroke:#B3A078,color:#514532,stroke-width:1px
  classDef logical fill:#F3F4F6,stroke:#98A2AE,color:#344054,stroke-width:1px,stroke-dasharray:4 4
  linkStyle default stroke:#748798,stroke-width:1px

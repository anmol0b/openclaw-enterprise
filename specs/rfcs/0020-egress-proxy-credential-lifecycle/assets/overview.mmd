flowchart TB
  %% Proposed contract roles; boxes do not prescribe separate daemons.
  Agent["<b>Agent workload</b><br/>No provider credentials"]
  Network["<b>SandboxDriver</b><br/>Network enforcement<br/>installEgress / egressStatus"]
  Driver["<b>EgressProxyDriver</b><br/>Configure / withdraw<br/>Management only"]
  Sender["<b>EgressForwarder</b><br/>capture / forward<br/>Inject + protect responses"]
  OCC["<b>EgressAuthorizer</b><br/>OCC check before access<br/>and before send"]
  Provider["<b>Provider</b><br/>GitHub / inference"]
  Resolver["<b>CredentialResolver</b><br/>resolve if needed<br/>Static / warm dynamic"]
  Agent -. request .-> Network
  Network -. permitted traffic .-> Sender
  Driver -. exact attachment .-> Network
  Driver -. admitted configuration .-> Sender
  Sender -. checks 1 and 2 .-> OCC
  Sender -. between checks .-> Resolver
  Sender -. authorized send .-> Provider
  class Agent,Provider external
  class Sender action
  class Network gate
  class Driver,OCC,Resolver api
  classDef api fill:#EDF2F7,stroke:#879AB0,color:#25364A,stroke-width:1px
  classDef action fill:#EBF3F0,stroke:#7F9D93,color:#2B4038,stroke-width:1px
  classDef external fill:#F2EDF6,stroke:#A394AF,color:#40354B,stroke-width:1px
  classDef gate fill:#F7F1E5,stroke:#B3A078,color:#514532,stroke-width:1px
  linkStyle default stroke:#748798,stroke-width:1px

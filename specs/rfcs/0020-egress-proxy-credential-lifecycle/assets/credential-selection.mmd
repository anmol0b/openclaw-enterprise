---
flowchart TB
  Resolver["<b>CredentialResolver</b><br/>Resolve after OCC check 1"]
  Static["<b>Static adoption</b><br/>Admitted mode + target"]
  Live["<b>Live · new default</b><br/>Read current Secret<br/>Existing: explicit opt-in"]
  Approved["<b>Explicit update</b><br/>Selected owner + version<br/>No latest provenance read"]
  Bounds["<b>Serving-cache age</b><br/>10 min fresh / 4 h total<br/>Zero: authoritative read"]
  Snapshot["<b>Stored snapshot</b><br/>Exact owner + version<br/>Zero keeps storage"]
  Dynamic["<b>Dynamic · warm reader</b><br/>Exact WarmKey<br/>No request-time refresh"]
  Ready["<b>MaterialHandle</b><br/>One request / sender<br/>OCC check 2 required"]
  Cold["<b>NotReady</b><br/>No issuance or refresh<br/>No work scheduled"]
  Resolver -. static .-> Static
  Resolver -. dynamic .-> Dynamic
  Static -. live .-> Live
  Static -. explicit_update .-> Approved
  Live -. read / eligible cache .-> Bounds
  Approved -. snapshot target .-> Snapshot
  Snapshot -. read / eligible cache .-> Bounds
  Approved -. version read / cache .-> Bounds
  Bounds -. usable and not revoked .-> Ready
  Dynamic -. warm and unexpired .-> Ready
  Dynamic -. cold or expired .-> Cold
  class Resolver api
  class Live,Approved,Snapshot,Dynamic action
  class Static,Bounds gate
  class Ready api
  class Cold gate
  classDef api fill:#EDF2F7,stroke:#879AB0,color:#25364A,stroke-width:1px
  classDef action fill:#EBF3F0,stroke:#7F9D93,color:#2B4038,stroke-width:1px
  classDef gate fill:#F7F1E5,stroke:#B3A078,color:#514532,stroke-width:1px
  linkStyle default stroke:#748798,stroke-width:1px
